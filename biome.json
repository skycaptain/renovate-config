{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "includes": ["**/.vscode/*.json", "**/.devcontainer/*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    }
  ]
}
